# Copia este archivo como .env y cárgalo con: node --env-file=.env server.js
NODE_ENV=production
PORT=3000
# Obligatorio en producción. Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Dirección pública del sitio, sin barra final (se usa en enlaces canónicos y en el sitemap).
SITE_URL=https://ejemplo.org
# Correo de contacto que aparece en la política de privacidad (opcional).
CONTACT_EMAIL=
# Si el sitio está detrás de un proxy o balanceador (Nginx, Render, Railway...), pon 1.
TRUST_PROXY=1
# Pon 1 para redirigir http a https (requiere TRUST_PROXY si hay proxy).
FORCE_HTTPS=1
